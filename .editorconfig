# Editor defaults, so that a contributor's editor agrees with `cargo fmt` and
# with the files already here before CI has to say so.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4

[*.toml]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# Two trailing spaces are a line break in Markdown, so stripping them would
# silently reflow the documentation.
[*.md]
trim_trailing_whitespace = false
indent_size = 2
